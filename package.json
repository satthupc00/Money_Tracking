{
  "name": "mon-money-tracking",
  "private": true,
  "version": "2.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "vite build && npm run electron:main && electron .",
    "dist:win": "vite build && npm run electron:main && electron-builder --win nsis --publish never",
    "cap:sync": "npx cap sync android",
    "cap:open": "npx cap open android",
    "electron:main": "esbuild electron/main.cjs --bundle --platform=node --target=node20 --external:electron --outfile=electron-dist/main.cjs && node -e \"require('fs').copyFileSync('electron/preload.cjs','electron-dist/preload.cjs')\"",
    "preview:html": "vite build --config vite.preview.config.js"
  },
  "dependencies": {
    "@capacitor/android": "^6.1.0",
    "@capacitor/app": "^6.0.1",
    "@capacitor/core": "^6.1.0",
    "@capacitor/filesystem": "^6.0.1",
    "@capacitor/share": "^6.0.2",
    "capacitor-native-biometric": "^4.2.2",
    "electron-updater": "^6.8.9",
    "firebase": "^10.14.1",
    "lucide-react": "^0.383.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.1.0",
    "@vitejs/plugin-react": "^4.2.1",
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3",
    "vite": "^5.2.0",
    "vite-plugin-singlefile": "^2.3.4"
  },
  "productName": "Mon Money Tracking",
  "description": "Mon Money Tracking - theo dõi tài sản theo tháng",
  "author": "Mondiro",
  "main": "electron-dist/main.cjs",
  "build": {
    "appId": "com.mondiro.moneytracking",
    "productName": "Mon Money Tracking",
    "artifactName": "MonMoneyTracking-Setup-${version}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron-dist/**/*",
      "build/icon.png",
      "package.json",
      "!**/node_modules/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "shortcutName": "Mon Money Tracking",
      "uninstallDisplayName": "Mon Money Tracking"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "satthupc00",
        "repo": "Money_Tracking",
        "releaseType": "release"
      }
    ]
  }
}
